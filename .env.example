# Copy to .env and edit.  cp .env.example .env

# --- Connection ---
# new    = Deriv's current Options API (api.derivws.com). Recommended.
# legacy = old ws.derivws.com/websockets/v3 endpoint (now often fails with HTTP 520)
DERIV_API=new
# Only needed for live trading (PAPER_TRADING=false). Paper trading needs nothing.
# Register an app at https://developers.deriv.com to get your App ID, and create a
# Personal Access Token with the Trade scope.
DERIV_APP_ID=
DERIV_API_TOKEN=
# Optional: which account to trade. Defaults to your demo account.
DERIV_ACCOUNT_ID=

# --- Mode ---
# true = simulate trades using the live price feed, never buys anything
PAPER_TRADING=true
# The bot refuses to trade a real-money account unless this is true
ALLOW_REAL_ACCOUNT=false
# Paper mode: profit per 1 staked on a win, used if Deriv won't quote a payout
PAPER_PAYOUT=0.95

# --- Contract ---
# rise_fall    = Rise/Fall
# higher_lower = Higher/Lower: exit above (Higher) or below (Lower) entry + BARRIER
# even_odd     = Even/Odd (last digit of the exit price)
CONTRACT=rise_fall
# Higher/Lower only: barrier offset from the entry price. +0.1 = Higher must end
# at least 0.11 above entry. A negative barrier makes Higher easier but pays less.
BARRIER=+0.1
# Rise/Fall and Higher/Lower: higher (or rise) = only buy Rise/Higher,
# lower (or fall) = only Fall/Lower, both = either. Blank = both for Rise/Fall,
# higher for Higher/Lower.
TRADE_SIDE=
# Higher/Lower only: how the barrier is sent to Deriv. auto tries "+0.07",
# then 0.07, then an absolute price level, and keeps the first one Deriv accepts.
BARRIER_FORMAT=auto
SYMBOL=R_100            # R_10, R_25, R_50, R_75, R_100, 1HZ100V, ...
CURRENCY=USD
DURATION=5
DURATION_UNIT=t         # t=ticks (s/m allowed for Rise/Fall in live mode only; Even/Odd needs 1-10 ticks)

# --- Strategy ---
# rise_fall:    sma_cross | momentum | rsi | random | always_higher (= always Rise) | always_lower
# higher_lower: always_higher | always_lower | sma_cross | momentum | rsi | random
# even_odd:     digit_contrarian | digit_follow | random
# Leave blank for the contract's default (sma_cross / always_higher / digit_contrarian).
STRATEGY=
FAST_PERIOD=5
SLOW_PERIOD=20
MOMENTUM_WINDOW=5
RSI_PERIOD=14
RSI_LOW=30
RSI_HIGH=70
DIGIT_WINDOW=3          # Even/Odd: same-parity last digits in a row before trading
COOLDOWN_TICKS=3

# --- Dashboard ---
# Live dashboard at http://localhost:3000 while the bot runs (0 = off).
# A second bot running at the same time uses the next free port (3001, ...).
DASHBOARD_PORT=3000

# --- Risk management ---
STAKE=1
MAX_STAKE=10
MARTINGALE=1            # stake multiplier after a loss; 1 = off (recommended)
TAKE_PROFIT=10
STOP_LOSS=10
MAX_TRADES=50
MAX_CONSECUTIVE_LOSSES=5
