# Copy to .env and edit.  cp .env.example .env

# --- Connection ---
# Register your own app id at https://api.deriv.com (1089 is Deriv's public test id)
DERIV_APP_ID=1089
# API token from https://app.deriv.com/account/api-token (scopes: Read + Trade).
# Use a DEMO account token. Not needed for paper trading.
DERIV_API_TOKEN=

# --- Mode ---
# true = simulate trades using the live price feed, never buys anything
PAPER_TRADING=true
# The bot refuses to trade a real-money account unless this is true
ALLOW_REAL_ACCOUNT=false

# --- Contract ---
SYMBOL=R_100            # R_10, R_25, R_50, R_75, R_100, 1HZ100V, ...
CURRENCY=USD
DURATION=5
DURATION_UNIT=t         # t=ticks (s/m allowed in live mode only)

# --- Strategy: sma_cross | momentum | rsi ---
STRATEGY=sma_cross
FAST_PERIOD=5
SLOW_PERIOD=20
MOMENTUM_WINDOW=5
RSI_PERIOD=14
RSI_LOW=30
RSI_HIGH=70
COOLDOWN_TICKS=3

# --- Risk management ---
STAKE=1
MAX_STAKE=10
MARTINGALE=1            # stake multiplier after a loss; 1 = off (recommended)
TAKE_PROFIT=10
STOP_LOSS=10
MAX_TRADES=50
MAX_CONSECUTIVE_LOSSES=5
